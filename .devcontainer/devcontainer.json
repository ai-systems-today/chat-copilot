{
  "name": "Chat Copilot Dev",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "npm install -g yarn && cd frontend && yarn install && cd ../webapi && dotnet restore && bash .devcontainer/install-azcli.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens"
      ]
    }
  },
  "forwardPorts": [3000, 5120],
  "remoteUser": "vscode"
}